allow hal_power_default vendor_touchfeature_device:chr_file rw_file_perms;

# To do powerhint on nodes defined in powerhint.json
allow hal_power_default vendor_sysfs_gpu:dir search;
allow hal_power_default vendor_sysfs_gpu:file rw_file_perms;

# To access display idle state
allow hal_power_default vendor_sysfs_display:file r_file_perms;

allow hal_power_default proc_cpufreq:dir search;
allow hal_power_default proc_cpufreq:file rw_file_perms;

allow hal_power_default sysfs_ged:dir search;
allow hal_power_default sysfs_ged:file rw_file_perms;
allow hal_power_default self:perf_event cpu;

allow hal_power_default cpu_dma_latency_device:file rw_file_perms;
allow hal_power_default cpu_dma_latency_device:chr_file rw_file_perms;

set_prop(hal_power_default, vendor_mtk_powerhal_prop)

# FBT
allow hal_power_default sysfs_fbt_cpu:dir r_dir_perms;
allow hal_power_default sysfs_fbt_cpu:file rw_file_perms;
